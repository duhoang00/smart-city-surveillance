{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./styles.css": "./dist/index.css",
    "./*": "./dist/*.js"
  },
  "license": "MIT",
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:components": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:lib": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "concurrently \"tsc --watch -p tsconfig.json\" \"tsc-alias --watch -p tsconfig.json\"",
    "dev:lib": "concurrently \"tsc --watch -p tsconfig.json\" \"tsc-alias --watch -p tsconfig.json\"",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/tailwind-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/cli": "^4.1.5",
    "@types/react": "^19.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "tsc-alias": "^1.8.16",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "postcss": "^8.5.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "tw-animate-css": "^1.3.6"
  }
}
